__pycache__/
*.pyc
.venv/

# macOS
.DS_Store

# Spotify OAuth refresh token -- a live credential, never commit
.spotify_token.json

# Your own audio files -- never want these in git history
AudioFiles/
*.wav
*.mp3
*.flac
*.aud

# Your tuned LED profile -- per-installation, like AudioFiles/
led_profile.json

# ESP32 WiFi credentials -- copy wifi_secrets.example.h beside the sketch
wifi_secrets.h
